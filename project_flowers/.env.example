# Flask API Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=8001
API_HOST=0.0.0.0

# CORS Settings (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5187,http://localhost:3000,https://yourdomain.com

# Model Configuration
MODEL_PATH=oxford102_m2_optimized.h5
CLASS_NAMES_PATH=class_names.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=api.log

# Performance
MAX_IMAGE_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30
